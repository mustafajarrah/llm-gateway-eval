# Copy to .env and load it before starting the gateway:
#   set -a; source .env; set +a; make run
# The binary reads plain environment variables; it does not load .env itself.

# ---- Service ----------------------------------------------------------------
# Listen address. The default accepts connections from this machine only.
# Anything else (":8080", "0.0.0.0:8080") requires GATEWAY_API_KEY.
GATEWAY_ADDR=127.0.0.1:8080
# Bearer token clients must send. Empty disables authentication.
GATEWAY_API_KEY=
# SQLite file, or ":memory:" for a database that vanishes on exit.
GATEWAY_DB_PATH=data/gateway.db
# debug, info, warn or error.
GATEWAY_LOG_LEVEL=info

# ---- Routing and retries ----------------------------------------------------
# Named fallback chains: name=provider:model,provider:model;name2=...
# A request without "provider" uses "model" as a route name.
GATEWAY_ROUTES=
# Prices used to estimate cost, in US dollars per million tokens:
# provider:model=input/output;provider:model=input/output
# Models without an entry simply report no cost.
GATEWAY_PRICES=
# Tries per target before moving to the next one (default 2).
GATEWAY_MAX_ATTEMPTS=
# Time limit of a single provider call (default 60s).
GATEWAY_ATTEMPT_TIMEOUT=
# Consecutive unhealthy calls that open a circuit breaker (default 5). There
# is one breaker per model and one per provider. 0 disables circuit breaking.
GATEWAY_BREAKER_THRESHOLD=
# How long an open breaker skips its target before probing it (default 30s).
GATEWAY_BREAKER_COOLDOWN=
# Test cases evaluated in parallel (default 4).
GATEWAY_EVAL_CONCURRENCY=

# ---- Providers --------------------------------------------------------------
# A provider is enabled by setting its API key. Base URLs are optional.
OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Output limit for Anthropic requests that set none (default 16000).
ANTHROPIC_MAX_TOKENS=

GEMINI_API_KEY=
GEMINI_BASE_URL=

MISTRAL_API_KEY=
MISTRAL_BASE_URL=

# Keyless providers are enabled by their base URL.
# Local Ollama: http://localhost:11434/v1
OLLAMA_BASE_URL=

# Any OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
